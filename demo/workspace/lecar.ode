# Morris-Lecar cells coupled through their mean voltage
# ---- parameters ----
# gca: maximal Ca conductance (mS/cm^2)
par gca=4.4, gk=8, gl=2
par vca=120, vk=-84, vl=-60   # reversal potentials (mV)
par iapp=90   # applied current (uA/cm^2)
par phi=0.04, cm=20, gsyn=0.2
par va=-1.2, vb=18, vc=2, vd=30

# ---- gating and currents ----
minf(v)=.5*(1+tanh((v-va)/vb))
winf(v)=.5*(1+tanh((v-vc)/vd))
tauw(v)=1/cosh((v-vc)/(2*vd))
iion(v,w)=gca*minf(v)*(v-vca)+gk*w*(v-vk)+gl*(v-vl)

# ---- five cells ----
# vm: membrane voltage of cell j (mV)
vm[1..5]'=(iapp-iion(vm[j],w[j])+gsyn*(vbar-vm[j]))/cm
w[1..5]'=phi*(winf(vm[j])-w[j])/tauw(vm[j])
vbar=(vm1+vm2+vm3+vm4+vm5)/5
aux pair=vm2-vm4

@ total=1000, dt=0.5
done
