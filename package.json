{
	"name": "xpp",
	"displayName": "XPP",
	"description": "Provides XPP \"ode, inc\" syntax and functionalities for VSCode",
	"version": "0.4.0",
	"publisher": "MuhammadMoustafa",
	"author": {
		"name": "Muhammad Moustafa",
		"email": "muhammadmoustafa22@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MuhammadMoustafa/XPP-ODE-Extension.git",
		"home": "https://github.com/MuhammadMoustafa/XPP-ODE-Extension/blob/master/README.md"
	},
	"icon": "images/icon.png",
	"main": "./out/src/extension.js",
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"test": "mocha --require ts-node/register --ui tdd test/*.test.ts",
		"package": "vsce package",
		"publish:vscode": "vsce publish"
	},
	"devDependencies": {
		"@types/mocha": "^10.0.10",
		"@types/node": "^20.19.0",
		"@types/vscode": "~1.82.0",
		"@vscode/vsce": "^3.9.2",
		"mocha": "^11.1.0",
		"ts-node": "^10.9.2",
		"typescript": "^5.9.0"
	},
	"engines": {
		"vscode": "^1.82.0"
	},
	"activationEvents": [
		"onStartupFinished"
	],
	"categories": [
		"Programming Languages"
	],
	"contributes": {
		"languages": [
			{
				"id": "xpp",
				"aliases": [
					"XPP ODE",
					"XPP",
					"XPPAUT"
				],
				"extensions": [
					".ode",
					".inc"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "xpp",
				"scopeName": "source.xpp",
				"path": "./syntaxes/xpp.tmLanguage.json"
			}
		],
		"commands": [
			{
				"command": "xpp.runOdeFile",
				"title": "Run ODE File",
				"category": "XPP-ODE",
				"icon": "$(play)"
			},
			{
				"command": "xpp.extractVariable",
				"title": "XPP: Extract to Variable"
			},
			{
				"command": "xpp.toggleComment",
				"title": "Toggle Comment",
				"category": "XPP-ODE"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "xpp.runOdeFile",
					"group": "navigation",
					"when": "resourceLangId == xpp"
				}
			],
			"editor/context": [
				{
					"when": "editorHasSelection && editorLangId == xpp",
					"command": "xpp.extractVariable",
					"group": "1_modification"
				}
			]
		},
		"configuration": {
			"title": "XPP-ODE",
			"properties": {
				"xpp-ode.runCommand": {
					"type": "string",
					"default": "xppaut",
					"markdownDescription": "Command that runs an `.ode` file; the file name is appended. It runs in the file's folder. Examples: `xppaut`, `/usr/local/bin/xppaut`, `C:\\\\xppall\\\\xppaut.exe`, `wsl xppaut`, `xppaut -xorfix`."
				},
				"xpp-ode.display": {
					"type": "string",
					"default": "127.0.0.1:0.0",
					"markdownDescription": "Windows only. Value of the `DISPLAY` variable given to xppaut when it is not already set, so that the Cygwin build finds the X server (Xming, VcXsrv). Not used for `wsl ...` commands."
				},
				"xpp-ode.xServer": {
					"type": "string",
					"default": "",
					"markdownDescription": "Windows only. Command line of an X server to start automatically before running xppaut when it is not already running, e.g. `\"C:\\\\Program Files (x86)\\\\Xming\\\\Xming.exe\" :0 -multiwindow -clipboard`. Leave empty to start the server yourself."
				},
				"xpp-ode.debounceDelay": {
					"type": "number",
					"default": 300,
					"minimum": 0,
					"description": "Delay in milliseconds before updating diagnostics after text changes."
				},
				"xpp-ode.identifierColors": {
					"type": "object",
					"default": {},
					"markdownDescription": "Colours and styles for specific variables, parameters or functions, independent of the theme. Keys are XPP names (case-insensitive) or a category: `@states`, `@parameters`, `@fixed`, `@functions`, `@aux`, `@wiener`, `@markov`, `@tables`, `@options`, `@builtins`, `@keywords`. Values are a hex colour (`\"#ff8800\"`) or a style object with any of `color`, `backgroundColor`, `fontWeight`, `fontStyle`, `textDecoration`, `opacity`, `borderColor`, `borderStyle`, `borderWidth`, `borderRadius`, plus optional `light` / `dark` objects with theme-specific overrides. Put the setting in a workspace `.vscode/settings.json`, or create a `.xppcolors.json` file with the same content in a folder, to style every `.ode`/`.inc` file in that folder.",
					"additionalProperties": {
						"anyOf": [
							{
								"type": "string",
								"pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
								"description": "Hex colour: #rgb, #rrggbb or #rrggbbaa"
							},
							{
								"type": "object",
								"additionalProperties": false,
								"properties": {
									"color": {
										"type": "string",
										"pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
										"description": "Text colour: #rgb, #rrggbb or #rrggbbaa"
									},
									"backgroundColor": {
										"type": "string",
										"pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
										"description": "Background colour: #rgb, #rrggbb or #rrggbbaa"
									},
									"fontStyle": {
										"type": "string",
										"enum": [
											"normal",
											"italic"
										]
									},
									"fontWeight": {
										"type": "string",
										"enum": [
											"normal",
											"bold"
										]
									},
									"textDecoration": {
										"type": "string",
										"description": "CSS text-decoration, e.g. \"underline\", \"line-through\" or \"underline wavy\""
									},
									"opacity": {
										"type": "number",
										"minimum": 0,
										"maximum": 1
									},
									"light": {
										"type": "object",
										"additionalProperties": false,
										"properties": {
											"color": {
												"type": "string",
												"pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
												"description": "Text colour: #rgb, #rrggbb or #rrggbbaa"
											},
											"backgroundColor": {
												"type": "string",
												"pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
												"description": "Background colour: #rgb, #rrggbb or #rrggbbaa"
											},
											"fontStyle": {
												"type": "string",
												"enum": [
													"normal",
													"italic"
												]
											},
											"fontWeight": {
												"type": "string",
												"enum": [
													"normal",
													"bold"
												]
											},
											"textDecoration": {
												"type": "string",
												"description": "CSS text-decoration, e.g. \"underline\", \"line-through\" or \"underline wavy\""
											},
											"opacity": {
												"type": "number",
												"minimum": 0,
												"maximum": 1
											},
											"borderColor": {
												"type": "string",
												"pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
												"description": "Box colour: #rgb, #rrggbb or #rrggbbaa. Alone it gives a 1px solid box."
											},
											"borderStyle": {
												"type": "string",
												"enum": [
													"solid",
													"dashed",
													"dotted",
													"double"
												]
											},
											"borderWidth": {
												"type": [
													"string",
													"number"
												],
												"pattern": "^\\d+(\\.\\d+)?(px|em|rem|%)?$",
												"description": "Box line width, e.g. \"1px\""
											},
											"borderRadius": {
												"type": [
													"string",
													"number"
												],
												"pattern": "^\\d+(\\.\\d+)?(px|em|rem|%)?$",
												"description": "Box corner radius, e.g. \"3px\""
											}
										}
									},
									"dark": {
										"type": "object",
										"additionalProperties": false,
										"properties": {
											"color": {
												"type": "string",
												"pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
												"description": "Text colour: #rgb, #rrggbb or #rrggbbaa"
											},
											"backgroundColor": {
												"type": "string",
												"pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
												"description": "Background colour: #rgb, #rrggbb or #rrggbbaa"
											},
											"fontStyle": {
												"type": "string",
												"enum": [
													"normal",
													"italic"
												]
											},
											"fontWeight": {
												"type": "string",
												"enum": [
													"normal",
													"bold"
												]
											},
											"textDecoration": {
												"type": "string",
												"description": "CSS text-decoration, e.g. \"underline\", \"line-through\" or \"underline wavy\""
											},
											"opacity": {
												"type": "number",
												"minimum": 0,
												"maximum": 1
											},
											"borderColor": {
												"type": "string",
												"pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
												"description": "Box colour: #rgb, #rrggbb or #rrggbbaa. Alone it gives a 1px solid box."
											},
											"borderStyle": {
												"type": "string",
												"enum": [
													"solid",
													"dashed",
													"dotted",
													"double"
												]
											},
											"borderWidth": {
												"type": [
													"string",
													"number"
												],
												"pattern": "^\\d+(\\.\\d+)?(px|em|rem|%)?$",
												"description": "Box line width, e.g. \"1px\""
											},
											"borderRadius": {
												"type": [
													"string",
													"number"
												],
												"pattern": "^\\d+(\\.\\d+)?(px|em|rem|%)?$",
												"description": "Box corner radius, e.g. \"3px\""
											}
										}
									},
									"borderColor": {
										"type": "string",
										"pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
										"description": "Box colour: #rgb, #rrggbb or #rrggbbaa. Alone it gives a 1px solid box."
									},
									"borderStyle": {
										"type": "string",
										"enum": [
											"solid",
											"dashed",
											"dotted",
											"double"
										]
									},
									"borderWidth": {
										"type": [
											"string",
											"number"
										],
										"pattern": "^\\d+(\\.\\d+)?(px|em|rem|%)?$",
										"description": "Box line width, e.g. \"1px\""
									},
									"borderRadius": {
										"type": [
											"string",
											"number"
										],
										"pattern": "^\\d+(\\.\\d+)?(px|em|rem|%)?$",
										"description": "Box corner radius, e.g. \"3px\""
									}
								}
							}
						]
					},
					"properties": {
						"@states": {
							"anyOf": [
								{
									"type": "string",
									"pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
								},
								{
									"type": "object"
								}
							],
							"description": "State variables (x'=, dx/dt=, x(t+1)=, solv) everywhere they are used"
						},
						"@parameters": {
							"anyOf": [
								{
									"type": "string",
									"pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
								},
								{
									"type": "object"
								}
							],
							"description": "par / number parameters and !name= derived parameters"
						},
						"@fixed": {
							"anyOf": [
								{
									"type": "string",
									"pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
								},
								{
									"type": "object"
								}
							],
							"description": "Fixed variables (name=expression)"
						},
						"@functions": {
							"anyOf": [
								{
									"type": "string",
									"pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
								},
								{
									"type": "object"
								}
							],
							"description": "User functions f(x)="
						},
						"@aux": {
							"anyOf": [
								{
									"type": "string",
									"pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
								},
								{
									"type": "object"
								}
							],
							"description": "aux quantities"
						},
						"@wiener": {
							"anyOf": [
								{
									"type": "string",
									"pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
								},
								{
									"type": "object"
								}
							],
							"description": "wiener variables"
						},
						"@markov": {
							"anyOf": [
								{
									"type": "string",
									"pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
								},
								{
									"type": "object"
								}
							],
							"description": "markov variables"
						},
						"@tables": {
							"anyOf": [
								{
									"type": "string",
									"pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
								},
								{
									"type": "object"
								}
							],
							"description": "table and special names"
						},
						"@options": {
							"anyOf": [
								{
									"type": "string",
									"pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
								},
								{
									"type": "object"
								}
							],
							"description": "Option names on @ lines (dt, total, xp, ...)"
						},
						"@builtins": {
							"anyOf": [
								{
									"type": "string",
									"pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
								},
								{
									"type": "object"
								}
							],
							"description": "Builtin functions and constants (sin, heav, t, pi, ...)"
						},
						"@keywords": {
							"anyOf": [
								{
									"type": "string",
									"pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
								},
								{
									"type": "object"
								}
							],
							"description": "Declaration keywords (par, init, aux, done, ...)"
						}
					},
					"propertyNames": {
						"pattern": "^(@[a-z]+|[A-Za-z0-9_*]+)$"
					}
				}
			}
		},
		"jsonValidation": [
			{
				"fileMatch": ".xppcolors.json",
				"url": "./schemas/xppcolors.schema.json"
			}
		],
		"keybindings": [
			{
				"command": "xpp.toggleComment",
				"key": "ctrl+/",
				"when": "editorTextFocus && editorLangId == xpp"
			}
		]
	}
}
